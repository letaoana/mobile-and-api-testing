# Copy to `.env` and adjust for your machine. Every value is optional.

# ---------- Android (physical device or emulator) ----------
# `adb devices` shows the UDID. Leave empty to use the only connected device.
ANDROID_UDID=
ANDROID_DEVICE_NAME=Android Device
ANDROID_PLATFORM_VERSION=
ANDROID_APP_PATH=./apps/android.wdio.native.app.apk

# ---------- iOS ----------
# Simulator (default): the published demo build only runs on simulators.
IOS_DEVICE_NAME=iPhone 16
IOS_PLATFORM_VERSION=
IOS_APP_PATH=./apps/ios.simulator.wdio.native.app.zip
# Physical iPhone: provide a signed .ipa build, the device UDID and your signing team.
IOS_UDID=
IOS_XCODE_ORG_ID=
IOS_XCODE_SIGNING_ID=Apple Development

# ---------- Run options ----------
# Save a screen recording for every test (failures are always recorded).
RECORD_VIDEO=false

# ---------- Restful Booker API ----------
API_BASE_URL=https://restful-booker.herokuapp.com
BOOKER_USERNAME=admin
BOOKER_PASSWORD=password123
