# Copy to `.env` and adjust for your machine. Every value is optional.

# ---------- Android (physical device or emulator) ----------
# `adb devices` shows the UDID. Leave empty to use the only connected device.
ANDROID_UDID=
ANDROID_DEVICE_NAME=Android Device
ANDROID_PLATFORM_VERSION=
ANDROID_APP_PATH=./apps/android.wdio.native.app.apk
# With no device connected, npm run test:android starts an emulator and waits for it to boot.
# Set to false to turn this off. ANDROID_AVD picks the emulator (default: the newest Android version).
ANDROID_AUTO_EMULATOR=true
ANDROID_AVD=
ANDROID_EMULATOR_BOOT_TIMEOUT=240

# ---------- iOS ----------
# Simulator (default): the published demo build only runs on simulators.
IOS_DEVICE_NAME=iPhone 16
IOS_PLATFORM_VERSION=
IOS_APP_PATH=./apps/ios.simulator.wdio.native.app.zip
# Physical iPhone: provide a signed .ipa build, the device UDID and your signing team.
IOS_UDID=
IOS_XCODE_ORG_ID=
IOS_XCODE_SIGNING_ID=Apple Development
# Optional: a bundle id you can sign WebDriverAgent with (needed for free/personal teams).
IOS_WDA_BUNDLE_ID=

# ---------- Sauce Labs (npm run test:sauce:android / test:sauce:ios) ----------
SAUCE_LABS_USERNAME=
SAUCE_LABS_ACCESS_KEY=
SAUCE_REGION=eu-central-1
# Device name or regular expression, and OS version (empty = any)
SAUCE_ANDROID_DEVICE=
SAUCE_ANDROID_VERSION=
# iOS runs on a Sauce simulator by default; set to true (with a signed .ipa uploaded) for real iPhones
SAUCE_IOS_REAL_DEVICE=false
SAUCE_IOS_DEVICE=
# Sauce Labs simulators pair each iOS version with one Appium version (node scripts/sauce-list-platforms.mjs)
SAUCE_IOS_VERSION=
SAUCE_APPIUM_VERSION=
# App names in Sauce Labs storage (defaults: the files uploaded by npm run sauce:upload)
SAUCE_ANDROID_APP=
SAUCE_IOS_APP=

# ---------- BrowserStack (npm run test:browserstack:android / test:browserstack:ios) ----------
BROWSERSTACK_USERNAME=
BROWSERSTACK_ACCESS_KEY=
BROWSERSTACK_ANDROID_DEVICE=Google Pixel 8
BROWSERSTACK_ANDROID_VERSION=14.0
# App id or bs:// url (default: the id used by npm run browserstack:upload)
BROWSERSTACK_ANDROID_APP=
# BrowserStack runs iOS on real devices only: upload a signed .ipa (npm run browserstack:upload -- <.ipa>)
# and set the app id it prints.
BROWSERSTACK_IOS_APP=
BROWSERSTACK_IOS_DEVICE=iPhone 15
BROWSERSTACK_IOS_VERSION=17

# ---------- Cloud runs (Sauce Labs and BrowserStack) ----------
# Spec files run in parallel, one device each, up to the account's concurrency limit.
CLOUD_MAX_INSTANCES=2
# Build name shown in the provider's dashboard (default: date and time of the run)
CLOUD_BUILD=

# ---------- Demo app ----------
# Release downloaded by npm run app:download and used in BrowserStack app ids
APP_VERSION=v2.2.0

# ---------- Run options ----------
# Save a screen recording for every test (failures are always recorded).
RECORD_VIDEO=false

# ---------- Restful Booker API ----------
API_BASE_URL=https://restful-booker.herokuapp.com
BOOKER_USERNAME=admin
BOOKER_PASSWORD=password123
