{
  "name": "mobile-and-api-testing",
  "version": "1.0.0",
  "private": true,
  "description": "Native mobile UI automation (WebdriverIO + Appium) and REST API tests (Playwright) in TypeScript.",
  "type": "module",
  "engines": {
    "node": ">=22.22.2"
  },
  "scripts": {
    "doctor": "node --use-env-proxy scripts/doctor.mjs",
    "app:download": "node scripts/download-app.mjs",
    "appium:doctor": "appium driver doctor uiautomator2",
    "test:android": "wdio run config/wdio.android.conf.ts",
    "test:ios": "wdio run config/wdio.ios.conf.ts",
    "sauce:upload": "node scripts/sauce-upload-app.mjs",
    "test:sauce:android": "wdio run config/wdio.sauce.android.conf.ts",
    "test:sauce:ios": "wdio run config/wdio.sauce.ios.conf.ts",
    "browserstack:upload": "node scripts/browserstack-upload-app.mjs",
    "test:browserstack:android": "wdio run config/wdio.browserstack.android.conf.ts",
    "test:browserstack:ios": "wdio run config/wdio.browserstack.ios.conf.ts",
    "test:api": "playwright test",
    "test:api:report": "playwright show-report reports/api/html",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tests/api/tsconfig.json",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "author": "Lehlohonolo Letaoana",
  "license": "MIT",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.1",
    "@types/mocha": "^10.0.10",
    "@types/node": "^26.6.6",
    "@wdio/appium-service": "^10.2.0",
    "@wdio/cli": "^10.2.0",
    "@wdio/globals": "^10.2.0",
    "@wdio/junit-reporter": "^10.2.0",
    "@wdio/local-runner": "^10.2.0",
    "@wdio/mocha-framework": "^10.2.0",
    "@wdio/sauce-service": "^10.2.0",
    "@wdio/spec-reporter": "^10.2.0",
    "@wdio/types": "^10.2.0",
    "appium": "^4.0.0",
    "appium-uiautomator2-driver": "^9.2.2",
    "appium-xcuitest-driver": "^13.1.3",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "expect-webdriverio": "^8.1.0",
    "globals": "^17.14.0",
    "prettier": "^3.10.1",
    "tsx": "^4.23.15",
    "typescript": "~6.0",
    "typescript-eslint": "^8.73.0",
    "webdriverio": "^10.2.0",
    "zod": "^4.6.7"
  }
}
